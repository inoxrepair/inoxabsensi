// Schema production. Model dan nama kolom sengaja sama dengan schema SQLite
// agar source code Prisma tidak bercabang antara development dan production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  username      String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("karyawan")
  jabatan       String    @default("-")
  tanggalMasuk  String
  aktif         Boolean   @default(true)
  faceEmbedding   String?
  faceDidaftarkan String?
  cabangId      String?
  cabang        Cabang?   @relation(fields: [cabangId], references: [id], onDelete: SetNull)
  insentif      Insentif[]
  insentifTransaksi InsentifTransaksi[]
  pemetaanInsentif PemetaanInsentif[]
  accounts      Account[]
  sessions      Session[]
  jadwal        Jadwal[]
  absensi       Absensi[]
  kasbon        Kasbon[]
  payroll       Payroll[]
  pengajuanIzin PengajuanIzin[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([cabangId, aktif])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@id([identifier, token])
}

model Cabang {
  id          String  @id @default(cuid())
  nama        String  @unique
  kota        String
  lat         Float
  lng         Float
  radiusMeter Int     @default(100)
  aktif       Boolean @default(true)
  karyawan User[]
  absensi  Absensi[]
}

model Shift {
  id             String @id @default(cuid())
  nama           String @unique
  mode           String @default("terjadwal")
  mulaiMenit     Int
  selesaiMenit   Int
  toleransiMenit Int @default(10)
  minimumKerjaMenit Int?
  maksimalCycle Int @default(1)
  jadwal Jadwal[]
}

model JenisSeragam {
  id          String   @id @default(cuid())
  kode        String   @unique
  nama        String   @unique
  deskripsi   String?
  aktif       Boolean  @default(true)
  jadwal      Jadwal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Jadwal {
  id      String @id @default(cuid())
  userId  String
  tanggal String
  shiftId String?
  seragamId String?
  seragam String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  jenisSeragam JenisSeragam? @relation(fields: [seragamId], references: [id], onDelete: SetNull)
  @@unique([userId, tanggal])
  @@index([tanggal])
  @@index([seragamId])
}

model Absensi {
  id              String  @id @default(cuid())
  userId          String
  cabangId        String
  tanggal         String
  status          String
  masukMenit      Int?
  keluarMenit     Int?
  menitTelat      Int     @default(0)
  menitToleransi  Int?
  menitKotor      Int?
  modeShift       String  @default("terjadwal")
  minimumKerjaMenit Int?
  kekuranganMenit Int     @default(0)
  maksimalCycle   Int     @default(1)
  masukLat        Float?
  masukLng        Float?
  masukJarakMeter Int?
  keluarLat       Float?
  keluarLng       Float?
  keluarJarakMeter Int?
  catatan         String?
  editedBy        String?
  faceStatus      String?
  faceJarak       Float?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabang Cabang @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  cycles AbsensiCycle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, tanggal])
  @@index([cabangId, tanggal])
  @@index([tanggal, status])
}

model AbsensiCycle {
  id                 String @id @default(cuid())
  absensiId          String
  urutan             Int
  masukMenit         Int
  keluarMenit        Int?
  masukLat           Float?
  masukLng           Float?
  masukJarakMeter    Int?
  keluarLat          Float?
  keluarLng          Float?
  keluarJarakMeter   Int?
  absensi Absensi @relation(fields: [absensiId], references: [id], onDelete: Cascade)
  @@unique([absensiId, urutan])
  @@index([absensiId])
}

model Kasbon {
  id          String @id @default(cuid())
  userId      String
  jumlah      Int
  status      String @default("pending")
  periode     String
  keterangan  String?
  jumlahTerbayar Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, periode])
  @@index([status])
}

model PengajuanIzin {
  id              String   @id @default(cuid())
  userId          String
  dari            String
  sampai          String
  jenis           String
  alasan          String
  buktiKeterangan String?
  status          String   @default("pending")
  catatanAdmin    String?
  diprosesOleh    String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
  @@index([status])
}

model Payroll {
  id            String @id @default(cuid())
  userId        String
  periode       String
  gajiPokok     Int @default(0)
  tunjangan     Int @default(0)
  potonganTelat Int @default(0)
  kasbon        Int @default(0)
  catatan       String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, periode])
  @@index([periode])
}

model AuditLog {
  id           String   @id @default(cuid())
  aksi         String
  targetUserId String?
  tanggal      String?
  ringkasan    String
  dilakukanOleh String?
  dibuatPada   DateTime @default(now())
  @@index([aksi, dibuatPada])
}

model RolePermission {
  role String
  menu String
  @@id([role, menu])
}

/// Pengaturan global aplikasi (kunci -> nilai), mis. logo_aplikasi yang
/// isinya data URL gambar. Satu baris per kunci; diubah lewat Pengaturan,
/// bukan lewat deploy, supaya branding bisa diganti tanpa rilis baru.
model Pengaturan {
  kunci     String   @id
  nilai     String
  updatedAt DateTime @updatedAt
}

/// Pesan informasi (pengumuman) yang muncul sebagai popup setelah karyawan
/// absen masuk. Diatur di menu Informasi (super_admin): judul, isi, tombol
/// CTA, tanggal mulai tampil + durasi (hari), dan toggle aktif.
model Informasi {
  id           String   @id @default(cuid())
  judul        String
  isi          String
  /// Label tombol CTA; kosong = "Mengerti".
  ctaLabel     String   @default("Mengerti")
  /// Aksi tombol CTA: tutup (tutup popup), tautan (buka URL), halaman
  /// (buka halaman aplikasi).
  ctaAksi      String   @default("tutup")
  /// URL tujuan bila ctaAksi = tautan.
  ctaTautan    String?
  /// Path halaman aplikasi bila ctaAksi = halaman.
  ctaHalaman   String?
  /// Tanggal mulai tampil "yyyy-mm-dd".
  mulaiTanggal String
  /// Lama tampil dalam hari (termasuk tanggal mulai).
  durasiHari   Int      @default(3)
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([aktif, mulaiTanggal])
}

/// Riwayat login/logout karyawan (untuk menu Log Login, super_admin):
/// tiap baris mencatat siapa, kapan (sampai detik), jenis masuk/keluar,
/// alamat IP publik yang terlihat server, dan User-Agent mentah (untuk
/// mengenali perangkat). Login gagal TIDAK dicatat — hanya yang berhasil.
/// Logout hanya tercatat bila karyawan menekan tombol Keluar (sesi yang
/// habis sendiri tidak menghasilkan baris keluar).
model LogLogin {
  id        String   @id @default(cuid())
  userId    String
  /// "masuk" | "keluar".
  jenis     String
  /// IP publik pertama dari x-forwarded-for (atau x-real-ip).
  ip        String   @default("tidak-diketahui")
  /// User-Agent mentah dari header; dipakai untuk sidik perangkat.
  agen      String   @default("")
  /// ID perangkat per HP (10 karakter heksadesimal, dari cookie browser);
  /// null untuk baris sebelum fitur ini. Dipakai untuk sidik perangkat.
  perangkatId String?
  dibuatPada DateTime @default(now())

  @@index([userId, dibuatPada])
  @@index([dibuatPada])
}

/// Insentif karyawan dari laporan inox.my.id. Satu baris per karyawan per
/// periode "yyyy-mm". Dihasilkan dari sinkronisasi endpoint
/// /reports/incentive-line-orders di inox.my.id.
/// LEGACY: tidak lagi dibaca sejak 13 Nov 2026 — digantikan
/// InsentifTransaksi (satu baris per transaksi). Tabel dibiarkan sebagai arsip.
model Insentif {
  id        String @id @default(cuid())
  userId    String
  periode   String
  jumlah    Int
  jumlahTransaksi Int @default(0)
  tanggalAwal   String?
  tanggalAkhir  String?
  sinkronPada   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periode])
  @@index([periode])
  @@index([userId, periode])
}

/// Satu baris transaksi insentif dari inox.my.id (feed
/// /reports/incentive-line-orders). Disimpan per baris, bukan agregat
/// bulanan, supaya laporan bisa dijumlahkan untuk rentang tanggal apa pun.
/// Sinkron menimpa baris dalam rentang yang ditarik (hapus lalu isi ulang),
/// jadi sinkron ulang tidak menggandakan.
model InsentifTransaksi {
  id        String @id @default(cuid())
  userId    String
  /// Tanggal transaksi lokal "yyyy-mm-dd".
  tanggal   String
  /// ID transaksi di inox.my.id (transaction_id); satu transaksi bisa punya
  /// beberapa baris produk.
  transactionId Int
  invoiceNo   String @default("")
  productName String @default("")
  quantity    Int @default(0)
  /// Total komisi baris ini dalam rupiah (Tetap + Persentase).
  jumlah    Int
  /// Cabang/lokasi bisnis di iNOX (business_location).
  lokasi    String @default("")
  sinkronPada DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tanggal])
  @@index([tanggal])
}

model PemetaanInsentif {
  id        String   @id @default(cuid())
  namaInox  String
  namaKunci String   @unique
  userId    String
  dibuatPada DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
