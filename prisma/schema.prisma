// Skema iNox Absensi.
// Catatan: SQLite dipakai untuk development (tanpa enum & tanpa array native),
// jadi kolom bertipe union disimpan sebagai String dan divalidasi di
// src/lib/domain.ts. Provider bisa diganti postgresql tanpa mengubah relasi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// ---------------------------------------------------------------------------
/// Auth.js (skema minimal adapter Prisma)
/// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  /// Username login opsional untuk akun lama; akun baru wajib mengisinya.
  username      String?   @unique
  emailVerified DateTime?
  image         String?
  /// Hash bcrypt. Null jika user hanya login via Google.
  passwordHash  String?

  /// RoleKaryawan: super_admin | admin_cabang | karyawan
  role         String    @default("karyawan")
  jabatan      String    @default("-")
  /// Disimpan sebagai tanggal lokal "yyyy-mm-dd" agar bebas timezone.
  tanggalMasuk String
  aktif        Boolean   @default(true)

  cabangId String?
  cabang   Cabang? @relation(fields: [cabangId], references: [id], onDelete: SetNull)

  accounts Account[]
  sessions Session[]
  jadwal   Jadwal[]
  absensi  Absensi[]
  kasbon   Kasbon[]
  payroll  Payroll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cabangId, aktif])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// ---------------------------------------------------------------------------
/// Domain absensi
/// ---------------------------------------------------------------------------

model Cabang {
  id          String  @id @default(cuid())
  nama        String  @unique
  kota        String
  lat         Float
  lng         Float
  /// Radius toleransi absensi dalam meter.
  radiusMeter Int     @default(100)
  aktif       Boolean @default(true)

  karyawan User[]
  absensi  Absensi[]
}

model Shift {
  id   String @id @default(cuid())
  nama String @unique
  /// terjadwal | fleksibel
  mode String @default("terjadwal")
  /// Menit sejak tengah malam (mis. 09.00 = 540). Integer supaya
  /// perhitungan telat & durasi kerja tidak tersentuh timezone.
  mulaiMenit     Int
  selesaiMenit   Int
  toleransiMenit Int @default(10)
  /// Target minimum kerja untuk mode fleksibel; null berarti tanpa minimum.
  minimumKerjaMenit Int?
  maksimalCycle Int @default(1)

  jadwal Jadwal[]
}

model JenisSeragam {
  id          String   @id @default(cuid())
  kode        String   @unique
  nama        String   @unique
  deskripsi   String?
  aktif       Boolean  @default(true)
  jadwal      Jadwal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Satu baris = satu hari kerja satu karyawan. shiftId null berarti libur.
model Jadwal {
  id      String @id @default(cuid())
  userId  String
  /// Tanggal lokal "yyyy-mm-dd".
  tanggal String
  shiftId String?
  seragamId String?
  /// Snapshot nama lama untuk kompatibilitas/mempertahankan riwayat.
  seragam String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  jenisSeragam JenisSeragam? @relation(fields: [seragamId], references: [id], onDelete: SetNull)

  @@unique([userId, tanggal])
  @@index([tanggal])
  @@index([seragamId])
}

/// Satu baris per karyawan per hari; check-out mengisi kolom *Keluar.
model Absensi {
  id       String @id @default(cuid())
  userId   String
  cabangId String
  /// Tanggal lokal "yyyy-mm-dd".
  tanggal  String

  /// StatusAbsensi: hadir | telat | alpa | izin | libur
  status String

  masukMenit        Int?
  keluarMenit       Int?
  /// Menit keterlambatan setelah dikurangi toleransi shift; 0 bila tepat waktu.
  /// Disimpan saat check-in karena jam shift bisa diubah admin kemudian,
  /// sehingga menghitung ulang dari shift akan mengubah riwayat.
  menitTelat        Int     @default(0)
  modeShift         String  @default("terjadwal")
  minimumKerjaMenit Int?
  kekuranganMenit   Int     @default(0)
  /// Snapshot batas cycle saat absensi dibuat: terjadwal = 1, fleksibel = 3.
  maksimalCycle     Int     @default(1)
  masukLat          Float?
  masukLng          Float?
  masukJarakMeter   Int?
  keluarLat         Float?
  keluarLng         Float?
  keluarJarakMeter  Int?
  catatan           String?
  editedBy          String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabang Cabang @relation(fields: [cabangId], references: [id], onDelete: Cascade)
  cycles AbsensiCycle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tanggal])
  @@index([cabangId, tanggal])
  @@index([tanggal, status])
}

/// Pasangan masuk-keluar aktual. Shift fleksibel dapat memiliki maksimal tiga
/// cycle, sedangkan Absensi tetap satu baris per karyawan per tanggal.
model AbsensiCycle {
  id       String @id @default(cuid())
  absensiId String
  urutan    Int
  masukMenit Int
  keluarMenit Int?
  masukLat Float?
  masukLng Float?
  masukJarakMeter Int?
  keluarLat Float?
  keluarLng Float?
  keluarJarakMeter Int?

  absensi Absensi @relation(fields: [absensiId], references: [id], onDelete: Cascade)

  @@unique([absensiId, urutan])
  @@index([absensiId])
}

model Kasbon {
  id     String @id @default(cuid())
  userId String
  /// Rupiah, bilangan bulat.
  jumlah Int
  /// StatusKasbon: pending | disetujui | ditolak | lunas
  status String @default("pending")
  /// Periode payroll "yyyy-mm".
  periode  String
  keterangan String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, periode])
  @@index([status])
}

/// Komponen gaji per karyawan per periode. Semua nilai rupiah bilangan bulat
/// dan diisi manual oleh super admin, karena rumus lembur/THR/pajak belum
/// ditetapkan. Baris dibuat saat pertama kali diedit (bukan otomatis untuk
/// semua karyawan) agar tabel tidak dipenuhi baris bernilai nol.
model Payroll {
  id      String @id @default(cuid())
  userId  String
  /// Periode payroll "yyyy-mm".
  periode String

  gajiPokok     Int @default(0)
  tunjangan     Int @default(0)
  potonganTelat Int @default(0)
  kasbon        Int @default(0)

  catatan String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periode])
  @@index([periode])
}

/// Hak akses menu per role. Menggantikan matriks hardcode di halaman
/// Pengaturan sehingga perubahan akses tidak perlu deploy.
model RolePermission {
  role String
  menu String

  @@id([role, menu])
}

/// Snapshot sebelum perubahan jadwal; dipakai untuk membatalkan aksi terakhir.
