# PostgreSQL production. Gunakan connection string dari Neon/Supabase/Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate minimal 32 byte random secret:
# openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_SECRET_RANDOM"
AUTH_URL="https://absensi.example.com"
AUTH_TRUST_HOST="true"

# Opsional: Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Digunakan satu kali oleh npm run db:seed:prod
SEED_ADMIN_NAME="Owner iNox"
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_USERNAME="owner"
SEED_ADMIN_PASSWORD="GANTI_PASSWORD_MINIMAL_12_KARAKTER"
