{
  "name": "inox-absensi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "build": "next build",
    "build:prod": "prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy --schema prisma/schema.postgresql.prisma && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:seed:prod": "tsx prisma/seed-production.ts",
    "db:backfill-usernames": "tsx prisma/backfill-usernames.ts",
    "db:backfill-seragam": "tsx prisma/backfill-seragam.ts",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
