# Salin ke .env lalu sesuaikan. Jangan commit .env.

# Development memakai SQLite lokal (prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Auth.js. Generate dengan: npx auth secret
AUTH_SECRET=""

# URL publik aplikasi produksi, wajib HTTPS.
# Contoh: https://absensi.perusahaan.com
AUTH_URL=""
AUTH_TRUST_HOST="true"

# Opsional, untuk login Google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Hanya untuk menjalankan `npm run db:seed:prod` pertama kali.
SEED_ADMIN_NAME="Owner iNox"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_USERNAME="owner"
SEED_ADMIN_PASSWORD=""
